# Порт сервера
PORT=3000
# AI-советник (OpenAI-совместимый API). Без ключа работают советы по правилам.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# DeepSeek:   AI_BASE_URL=https://api.deepseek.com/v1      AI_MODEL=deepseek-chat
# OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=openai/gpt-4o-mini
# YandexGPT:  AI_BASE_URL=https://llm.api.cloud.yandex.net/v1  AI_MODEL=gpt://<folder_id>/yandexgpt-lite/latest
AI_RATE_PER_MIN=8
# RSS-ленты новостей через запятую (необязательно)
# NEWS_FEEDS=https://rssexport.rbc.ru/rbcnews/news/30/full.rss,https://forklog.com/feed
